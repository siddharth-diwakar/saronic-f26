# Local development only. Set DATABASE_URL separately in Coolify runtime variables.
DATABASE_URL=postgresql://saronic:local-development-only@127.0.0.1:5433/saronic
APP_ENV=development
LOG_LEVEL=info

# Used only by compose.local.yaml; never use this password in production.
POSTGRES_PASSWORD=local-development-only

# Session API key sent as X-API-Key. Required when APP_ENV=production; optional locally.
# SARONIC_API_KEY=replace-with-a-long-random-string

# Worker only. Never commit a real key; in Coolify mark it as a secret.
# BREV_API_KEY=replace-with-brev-api-key
# BREV_LAUNCHABLE_ID=env-3KBxE5OmaRkasfoXEDUhXeFleBL
# BREV_CLI_PATH=brev
# BREV_COMMAND_TIMEOUT_S=120
# WORKER_POLL_INTERVAL_S=10

# Sessions
# SARONIC_REPO_URL=https://github.com/siddharth-diwakar/saronic-f26
# SARONIC_DEFAULT_REF=main
# MAX_ACTIVE_SESSIONS=1

# Set to "worker" for the worker container so its healthcheck uses the heartbeat.
# PROCESS_ROLE=api

# Optional. Failure and stuck-session alerts. Leave unset to disable Slack.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
